input-data/
challenge_docs/
data/*
!data/README.md
*.parquet
*.feather
*.h5
*.hdf5
*.xlsx

# Generated outputs (submissions, figures, model artefacts)
outputs/*
!outputs/.gitkeep
models/
mlruns/
*.pkl
*.joblib
*.pt
*.onnx

# Secrets / credentials (leaderboard token, API keys)
.env
.env.*
!.env.example
secrets/
.pi/

# ---------------------------------------------------------------------------
